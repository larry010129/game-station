# Buy Me a Coffee — tip/support link for the Support (Buy Credits) page.
# Copy this file to app/.env and set your real page. Restart Vite (`npm run dev`) after editing.
# Tips do NOT auto-add Station Credits; Credits are earned/quested in-app.
VITE_BUY_ME_A_COFFEE_URL=https://buymeacoffee.com/yourname
#
# Canonical name (docs / scripts). The UI reads VITE_BUY_ME_A_COFFEE_URL above:
# BUY_ME_A_COFFEE_URL=https://buymeacoffee.com/yourname
#
# --- Stripe (removed) ---
# Paid Checkout is no longer used. Leave these unset / commented.
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
