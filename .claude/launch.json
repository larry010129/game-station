{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "command-station",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "app", "run", "live"],
      "port": 1420
    },
    {
      "name": "frontend-only",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "app", "run", "dev"],
      "port": 1420
    },
    {
      "name": "frontend-alt-port",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "app", "run", "dev", "--", "--port", "1421", "--strictPort"],
      "port": 1421
    },
    {
      "name": "service-only",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "app", "run", "service"],
      "port": 8787
    },
    {
      "name": "remotion",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "gacha-remotion", "run", "dev", "--", "--port=3100"],
      "port": 3100
    },
    {
      "name": "cms",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "cms", "run", "dev"],
      "port": 1430
    }
  ]
}
