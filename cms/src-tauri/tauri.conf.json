{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Command CMS",
  "mainBinaryName": "Command CMS",
  "version": "0.1.0",
  "identifier": "studio.yuzi.commandcms",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && node scripts/prepare-desktop.mjs",
    "frontendDist": "splash"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Command CMS",
        "url": "index.html",
        "width": 1440,
        "height": 940,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/node"],
    "resources": {
      "stage/cms/": "cms/"
    }
  }
}
