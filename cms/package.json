{
  "name": "game-station-cms",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 1430 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 1430 --strictPort",
    "seed": "node scripts/seed-draft.mjs",
    "publish:check": "node --input-type=module -e \"import { ensureDataLayout, publish, currentInfo } from './server/store.mjs'; ensureDataLayout(); console.log(JSON.stringify({ before: currentInfo(), result: publish() }, null, 2))\"",
    "tauri": "tauri",
    "prepare:desktop": "node scripts/prepare-desktop.mjs",
    "desktop:build": "tauri build --bundles nsis",
    "serve": "node server/standalone.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.73.0",
    "motion": "^14.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  }
}
